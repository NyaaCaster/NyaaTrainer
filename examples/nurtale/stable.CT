-- ===================================================================
-- Nurtale Nesche —— 稳定地址自动解析 + 小面板修改器
--
-- 定位链（Unity Mono，实例字段型）：
--     GUIHUDManager.instance        ★ 静态字段（唯一稳定锚点）
--       + healthGUI   -> HealthCanvasManager
--              + health -> Health
--                     +0x60 maxHealth / +0x64 healthCap
--                     +0x68 currentHealth        ← HP
--                     +0x6C maxStamina / +0x70 staminaCap
--                     +0x74 currentStamina       ← 体力
--                     +0x78 staminaRestoreAmount
--                     +0x88 IsUnDamagable        ← 无敌
--       + arouseGaugeManager -> ArouseGaugeManager
--                     +0x30 maxarouse / +0x34 currentarouse  ← 性快感
--
--   为什么不用 AOB：实测 AOB 依赖具体数值（35/80/45/80），游戏一升级改
--   maxHealth 就失配。本链依赖「类名 + 字段偏移」，与数值无关。
--   字段偏移全部从 mono_class_enumFields 动态取，不硬编码 —— 字段改名会
--   明确报错，而不是静默读到垃圾值。
--
-- 关于性快感：真源未确定（写入会被游戏覆盖），故用 50ms 高频重写压制，
--   实测可稳定显示。锁定按钮只管 HP / 体力。
--
-- 关于中文名：CE 地址列表的 Description 一律用 ASCII 内部键（key），
--   面板显示用中文（label）—— 两者分离。原因：CE 记录名带中文时
--   string.find 匹配不上（编码不一致），而脚本要靠 Description 找条目。
--
-- 排版：getScreenDPI() 恒回 96、fixDPI() 是空操作、Canvas.TextWidth 在
--   CE 的 Lua 里是 nil —— 只有 Font.Height 可用。宽度封顶也不要用
--   getScreenWidth()（它返回物理像素，与窗体逻辑像素差一倍），
--   改用 CE 主窗口宽度做参照。
-- ===================================================================

local PROCESS_NAME = 'Nurtale Nesche.exe'
local LOG_PATH = 'C:\\Windows\\Temp\\nurtale_trainer_log.txt'
-- 字号 12：DSH(Session 0) 与用户会话的字体度量差约一倍
-- （本机实测 Session0：16pt->43px；用户在样例里 16pt->21px）
-- 取下限字号 + 按 CE 主窗口宽度封顶，保证在用户会话不超屏。
local FS = 12

local function say(s)
  print('[NurtaleNesche] ' .. tostring(s))
  pcall(function()
    local f = io.open(LOG_PATH, 'a')
    if f then
      f:write(os.date('%H:%M:%S ') .. tostring(s) .. '\n')
      f:close()
    end
  end)
end

pcall(function()
  local f = io.open(LOG_PATH, 'w')
  if f then f:write('=== Nurtale Nesche trainer ' .. os.date() .. ' ===\n'); f:close() end
end)

-- ------------------------------------------------------------------
-- 数值项定义
--
-- 字段说明（这套标记是"数值行控件"的行为契约）：
--   key      内部键（ASCII，CE 地址条目的 Description 用它 —— 中文会让查找失效）
--   label    面板显示名（中文）
--   obj      所属对象（HEALTH / GAUGE）
--   field    类内字段名（运行时按名字解析偏移）
--   vt       类型：'float' 或 'int'
--   maxKey   该值的"运行时上限"对应哪个条目（用于 MAX 按钮）。
--            **留空表示没有上限概念 -> 该行不显示 MAX 按钮**
--            （用户拍板：无上限项隐藏 MAX，但保留按钮占位以维持矩阵工整）
--   noZero   true = 禁止归零（该行不显示 0 按钮）。
--            用户拍板：**上限性质**与**开关性质**的项目隐藏 0 按钮 ——
--            因为 HP上限=0 这类值可能让游戏异常（除零/血条崩溃）。
--
-- 已摘除项（用户拍板，2026-09-20）：
--   HP硬上限 / 体力硬上限 / 快感上限 / 恢复速度
--   —— 前三个对玩家无用（是内部天花板），恢复速度属于"一次改值"且可用输入框完成。
-- ------------------------------------------------------------------
local WANT = {
  { key = 'HP',        label = 'HP',       obj = 'HEALTH', field = 'currentHealth',  vt = 'float', maxKey = 'MaxHP' },
  { key = 'MaxHP',     label = 'HP上限',   obj = 'HEALTH', field = 'maxHealth',      vt = 'int',   noZero = true },
  { key = 'Stamina',   label = '体力',     obj = 'HEALTH', field = 'currentStamina', vt = 'float', maxKey = 'MaxStamina' },
  { key = 'MaxStamina',label = '体力上限', obj = 'HEALTH', field = 'maxStamina',     vt = 'int',   noZero = true },
  { key = 'Arouse',    label = '性快感',   obj = 'GAUGE',  field = 'currentarouse',  vt = 'float', maxKey = 'MaxArouse' },
  -- 快感上限本身已摘除，但性快感的 MAX 需要它 —— 用"隐藏条目"仅供内部取上限值，
  -- 不参与面板行渲染、也不进 CE 地址列表（见 WANT_HIDDEN 的处理）
}

-- 仅供内部使用（不渲染行、不进地址列表）的隐藏条目。
-- 存在理由：性快感的 MAX 需要一个"上限值"来源；上限项本身对玩家无意义，
-- 所以取它的值但不在界面上暴露。
local WANT_HIDDEN = {
  { key = 'MaxArouse', label = '快感上限', obj = 'GAUGE', field = 'maxarouse', vt = 'float' },
}

local HEALTH_CLASS = 'Health'
local GAUGE_CLASS  = 'ArouseGaugeManager'

-- ------------------------------------------------------------------
-- 状态开关（无数值，只有 生效/不生效 两态）
--
-- 用户拍板：这类项目【不再放进数值修改模块】，而是单独一组「状态开关」，
-- 控件用【勾选框】（不是"开/关"两个按钮）—— 一个勾选框就是二态开关，
-- 用两个按钮表达既是重复入口、又占宽度。
--
-- 本游戏目前只有一项：无敌模式（IsUnDamagable，0/1）。
-- 判定"是否生效"：读该字段 != 0。
-- ------------------------------------------------------------------
local SWITCHES = {
  { key = 'Invincible', label = '无敌模式', obj = 'HEALTH', field = 'IsUnDamagable',
    tip = '开启后受到攻击不掉血' },
}

-- 全部需要解析地址的条目（含隐藏项与状态开关）—— 只用于【解析地址】。
-- 其中只有 WANT 会写进 CE 地址列表；WANT_HIDDEN 与 SWITCHES 只在面板内部用。
local ALL_ITEMS = {}
do
  local i
  for i = 1, #WANT do ALL_ITEMS[#ALL_ITEMS + 1] = WANT[i] end
  for i = 1, #WANT_HIDDEN do ALL_ITEMS[#ALL_ITEMS + 1] = WANT_HIDDEN[i] end
  for i = 1, #SWITCHES do ALL_ITEMS[#ALL_ITEMS + 1] = SWITCHES[i] end
end


-- ------------------------------------------------------------------
-- 共享状态（必须先声明，再被下面的函数引用）
--
-- ⚠️ 踩过的坑：PLAYER_ADDR 原先声明在 apply() 附近（文件后段），
--   而 familyService() 在文件前段就引用了它。Lua 的 local 是【词法作用域】——
--   familyService 定义时该 local 还不存在，于是它读到的是【全局】_G.PLAYER_ADDR
--   （永远是 nil），而 apply() 写的是那个 local。
--   症状极隐蔽：日志里 "Player = XXXX" 明明解析成功，点按钮却报 "Player 未解析"。
--   正解：把共享变量统一声明在文件最前面。
-- ------------------------------------------------------------------
local ADDR = {}          -- 数值条目：key -> 绝对地址
local ROWS = {}          -- 面板控件引用
local PLAYER_ADDR = nil  -- ★ Player 实例地址（apply 解析后填入）
local panel = nil
local tries = 0
local diagDone = false
local needRescan = false
local rescans = 0

-- ===================================================================
-- 三个异常状态家族（服从 / 淫乱 / 受虐倾向），各 1~3 级
--
-- 只用正规托管 API，**绝不手工改 Dictionary 内部结构**
--   （2026-09-20 曾因手工改 _active 哈希表导致游戏崩溃）
--
-- 关键安全机制（也是崩溃换来的教训）：
--   mono_invoke_method 走【每线程命名管道】通信。管道失效时若继续调用，
--   会把垃圾写进管道 -> 采集器解析出错 -> 目标进程崩溃。
--   所以：**调用前必须 pipeOK()，不健康就拒绝调用**。
--
-- 验证过的可用方法：
--   ProgressiveStatusFamilyService.TrySetLevel(familyId, level)  -- 设等级
--   ProgressiveStatusFamilyService.TryDowngrade(familyId)        -- 降一级
-- ===================================================================

local FAMILIES = {
  { id = 'obedience',   cn = '服从',     row = nil },
  { id = 'nymphomania', cn = '淫乱',     row = nil },
  { id = 'masochism',   cn = '受虐倾向', row = nil },
}

-- 等级显示：0 = 无，1~3 用罗马数字（界面风格统一，也比"设为N"省空间）
--
-- ⚠️ 踩过的坑：Lua 的 table 下标从 1 开始，而这里的"等级"从 0 开始。
--   写成 LV_ROMAN = { '0', 'Ⅰ', 'Ⅱ', 'Ⅲ' } 后按 LV_ROMAN[lv] 取，
--   当 lv=1 时会拿到 '0' —— **整体错位一格**，第 4 个按钮永远是 'Ⅱ'，
--   'Ⅲ' 根本显示不出来（用字节级检查才发现的）。
--   正解：显式按 level 建映射，不用数组下标。
local LV_ROMAN = { [0] = '0', [1] = 'Ⅰ', [2] = 'Ⅱ', [3] = 'Ⅲ' }

-- 管道健康检查：返回 true 才能调用托管方法
-- 管道健康检查 + 按需建立
--
-- ⚠️ 为什么需要"建立"这一步（关键修复）：
--   mono_invoke_method 走【每线程】命名管道（libmono.monopipes[threadId]）。
--   实测发现：**CE 的定时器回调可能跑在与之前不同的线程上**，
--   那个线程如果没有管道，最初版本的 pipeOK() 会直接返回 false，
--   于是定时器里的锁定【永远静默失败】—— 而手动点按钮（另一个线程）却正常。
--   这正好解释了"手动写入有效、锁定无效"的现象。
--
--   修法：发现本线程没管道时，**主动调 getMonoPipe() 建立**（它是全局函数，
--   monoscript.lua 里带按线程缓存逻辑），建好再判断。
local function pipeOK()
  if type(libmono) ~= 'table' then return false, 'libmono missing' end
  if libmono.abort then return false, 'libmono.abort' end
  if libmono.MDC_ShuttingDownAddress then
    local sd = readInteger(libmono.MDC_ShuttingDownAddress)
    if sd == nil or sd ~= 0 then return false, 'MDC shutting down' end
  end
  if type(libmono.monopipes) ~= 'table' then return false, 'no monopipes' end

  local tid = getCurrentThreadID()
  local p = libmono.monopipes[tid]

  -- 本线程还没有管道 -> 主动建立（而不是直接放弃）
  if p == nil and type(getMonoPipe) == 'function' then
    local ok, r = pcall(getMonoPipe)
    if ok then p = libmono.monopipes[tid] end
  end

  if p == nil then return false, 'no pipe for thread ' .. tostring(tid) end
  if p.Connected == false then
    -- 断了的管道：销毁后重建一次
    pcall(function() p.destroy() end)
    libmono.monopipes[tid] = nil
    if type(getMonoPipe) == 'function' then pcall(getMonoPipe) end
    p = libmono.monopipes[tid]
    if p == nil then return false, 'pipe reconnect failed' end
    if p.Connected == false then return false, 'pipe still disconnected' end
  end
  if libmono.monopipe == nil then return false, 'monopipe nil' end
  return true
end

local function clsNameOf(p)
  if not p or p == 0 then return 'nil' end
  local n = nil
  pcall(function() n = mono_class_getName(mono_object_getClass(p)) end)
  if not n or n:find('[%z\1-\31]') then return 'nil' end
  return n
end

-- 把 64 位地址拆成 8 个小端字节，拼成 AOB 模式串。
-- 刻意不用位运算的与操作（XML 里该字符需转义，裸写会让 XML 解析器失败）；
-- 改用取模/取整：byte = floor(addr / 256^i) % 256
local function findPtrTo(addr)
  local b = {}
  local v = addr
  for i = 0, 7 do
    b[#b+1] = string.format('%02X', v % 256)
    v = math.floor(v / 256)
  end
  return AOBScan(table.concat(b, ' '))
end

-- 解析 ProgressiveStatusFamilyService（复用 Player 链）
local function familyService()
  local p = PLAYER_ADDR
  if not p or p == 0 then return nil, 'Player 未解析' end
  local semOff = 0x168
  local c = mono_findClass('PlayerGroup', 'Player')
  if c and c ~= 0 then
    for _, f in ipairs(mono_class_enumFields(c)) do
      if f.name == 'StatusEffectManager' then semOff = f.offset end
    end
  end
  local sem = readPointer(p + semOff)
  if not sem or sem == 0 then return nil, 'SEM nil' end
  local svcOff = 0x68
  local c2 = mono_findClass('', 'StatusEffectManager')
  if c2 and c2 ~= 0 then
    for _, f in ipairs(mono_class_enumFields(c2)) do
      if f.name == '_progressiveFamilies' then svcOff = f.offset end
    end
  end
  local svc = readPointer(sem + svcOff)
  if not svc or svc == 0 then return nil, 'service nil' end
  return svc, nil, sem
end

-- 只读遍历托管字典（绝不写）
local function readDict(dict)
  local res = {}
  if not dict or dict == 0 then return res end
  local cnt = readInteger(dict + 0x40)
  if not cnt then return res end
  if cnt > 100000 then return res end
  if cnt > 0 then else return res end
  local entries = readPointer(dict + 0x18)
  if not entries or entries == 0 then return res end
  local arrLen = readInteger(entries + 0x18)
  if not arrLen then return res end
  if arrLen > 100000 then return res end
  if arrLen > 0 then else return res end
  local base = entries + 0x20
  for i = 0, arrLen - 1 do
    local e = base + i * 0x18
    local kp = readPointer(e + 0x08)
    local vp = readPointer(e + 0x10)
    if kp and kp ~= 0 and vp and vp ~= 0 then
      local k = nil
      pcall(function() k = readString(kp + 0x14, 128, true) end)
      if k and k ~= '' then res[#res + 1] = k end
    end
  end
  return res
end

-- 读三个家族的当前等级（0 = 无）
local function familyLevels()
  local svc, err, sem = familyService()
  if not svc then return nil, err end
  local semCls = mono_findClass('', 'StatusEffectManager')
  local actOff = 0x88
  if semCls and semCls ~= 0 then
    for _, f in ipairs(mono_class_enumFields(semCls)) do
      if f.name == '_active' then actOff = f.offset end
    end
  end
  local d = readPointer(sem + actOff)
  local ids = readDict(d)
  local set = {}
  for _, k in ipairs(ids) do set[k] = true end
  local res = {}
  for _, fam in ipairs(FAMILIES) do
    local lvl = 0
    for i = 1, 3 do
      if set['status_effect.' .. fam.id .. '.' .. i] then lvl = i end
    end
    res[fam.id] = lvl
  end
  return res
end

local function findMethod(clsN, mName)
  local c = mono_findClass('', clsN)
  if not c or c == 0 then return nil, 'no class ' .. clsN end
  local ms = mono_class_enumMethods(c)
  if not ms then return nil, 'no methods' end
  for i = 1, #ms do
    if ms[i].name == mName then return ms[i].method end
  end
  return nil, 'no method ' .. mName
end

--[[
  单次操作。action: 'set' (level 1~3) 或 'down' (降一级)
  返回 ok, msg。**只做一次托管调用**，调用方负责循环与复查。
]]
local function familyOp(famId, action, level)
  local pk, why = pipeOK()
  if not pk then return false, '管道不健康，拒绝调用: ' .. tostring(why) end

  local dms = mono_enumDomains()
  local dom = dms and dms[1]
  if not dom then return false, 'no mono domain' end
  local svc, err = familyService()
  if not svc then return false, 'service 解析失败: ' .. tostring(err) end

  local mName = (action == 'down') and 'TryDowngrade' or 'TrySetLevel'
  local m, e2 = findMethod('ProgressiveStatusFamilyService', mName)
  if not m then return false, tostring(e2) end
  local fs = mono_new_string(dom, famId)
  if not fs or fs == 0 then return false, 'mono_new_string 失败' end

  local args
  if action == 'down' then
    args = { fs }
  else
    args = { fs, level }
  end
  local ok, r = pcall(mono_invoke_method, dom, m, svc, args)
  if not ok then return false, 'invoke 失败: ' .. tostring(r) end
  return true, string.format('%s(%s%s) -> %s', mName, famId,
    (action == 'down') and '' or (',' .. tostring(level)), tostring(r))
end

-- 清除到 0 级：分步降级，每步之间复查管道（绝不在一个循环里猛调）
local function familyClear(famId, maxSteps)
  maxSteps = maxSteps or 3
  local n = 0
  for i = 1, maxSteps do
    local lv = familyLevels()
    if not lv then break end
    -- 用 > 表达，避免裸尖括号（.CT 是 XML，裸尖括号会让脚本静默不执行）
    if lv[famId] > 0 then else break end
    local ok = familyOp(famId, 'down')
    if not ok then break end
    n = n + 1
  end
  return n
end

-- ===================================================================
-- 性快感：必须走 SexualHeatManager.Set()，不能直接写字段
--
-- 血泪教训（改了很多轮才明白）：
--   ArouseGaugeManager.currentarouse 只是【显示副本】。直接写它：
--     - 值确实变了（回读能看到）
--     - 但【界面不动】，而且游戏下一次推送就把它覆盖回来
--   原因：UI 刷新靠事件通知，写字段不触发事件。
--
-- 真源在 SexualHeatManager._heat（@+0x40）。继承链实测：
--     PlayerSexualArousalManager
--       ↑ CaptiveSexualHeatManager
--           ↑ SexualHeatManager        ← _heat 在这里
--               ↑ MonoBehaviour
--   而 Player.SexualHeatManager (@+0x1B8) 拿到的是 PlayerSexualArousalManager 实例，
--   所以 _heat 实际就在 PSA 实例的 +0x40 —— 这也解释了那块"字段表外的数值区"。
--
-- 正解：调用父类 SexualHeatManager 的 Set(value)。
--   一次调用同时完成：写 _heat + 触发 OnValueChange + UI 自动同步（实测两层都变）。
--   注意 CE 的 mono_class_enumMethods 只列【本类声明】的方法，不含继承的，
--   所以必须用 mono_findClass('','SexualHeatManager') 取到 Set。
-- ===================================================================

-- 拿到 PSA(PlayerSexualArousalManager) 实例地址
local function arousalHolder()
  if not PLAYER_ADDR or PLAYER_ADDR == 0 then return nil, 'Player 未解析' end
  local off = 0x1B8
  local c = mono_findClass('PlayerGroup', 'Player')
  if c and c ~= 0 then
    for _, f in ipairs(mono_class_enumFields(c)) do
      if f.name == 'SexualHeatManager' then off = f.offset end
    end
  end
  local psa = readPointer(PLAYER_ADDR + off)
  if not psa or psa == 0 then return nil, 'PlayerSexualArousalManager 为 nil' end
  return psa
end

-- 设置性快感值（走正规 Set 方法）。返回 ok, msg
--
-- ⚠️ 内置限流：同一值在 MIN_GAP 毫秒内不重复调用。
--    原因：tickLocks 会周期性重设快感值，若间隔太短就成了"高频连续调用托管方法"，
--    实测这种模式有崩溃风险。限流保证最坏情况下也是安全频率。
local AROUSE_LAST_T = 0
local AROUSE_LAST_V = nil
local AROUSE_MIN_GAP = 200

local function setArouse(value)
  local now = getTickCount()
  -- 写成 > 的形式，避免裸尖括号
  if AROUSE_LAST_V == value and AROUSE_MIN_GAP > (now - AROUSE_LAST_T) then
    return true, 'throttled'
  end
  -- ⚠️ 注意：时间戳【只在成功后】更新（见函数末尾）。
  --    早期版本在这里就更新了，导致一次失败会把限流窗口一起"吃掉"，
  --    后续重试被误判成"刚调过"而跳过。

  local pk, why = pipeOK()
  if not pk then return false, '管道不健康: ' .. tostring(why) end
  local psa, err = arousalHolder()
  if not psa then return false, tostring(err) end
  local setM, e2 = findMethod('SexualHeatManager', 'Set')
  if not setM then return false, tostring(e2) end
  local dms = mono_enumDomains()
  local dom = dms and dms[1]
  if not dom then return false, 'no mono domain' end
  local ok, r = pcall(mono_invoke_method, dom, setM, psa, { value })
  if not ok then return false, 'invoke 失败: ' .. tostring(r) end

  -- 成功后才记账（限流窗口从成功那一刻起算）
  AROUSE_LAST_T = now
  AROUSE_LAST_V = value
  return true, string.format('Set(%.2f) -> %s', value, tostring(r))
end

-- 读性快感真源（只读，不用管道）
local function getArouseHeat()
  local psa = arousalHolder()
  if not psa then return nil end
  return readFloat(psa + 0x40)
end

-- （ADDR / ROWS / PLAYER_ADDR 等共享变量已声明在文件开头，此处不再重复声明）

local function diag()
  diagDone = true
  say('CE dir = ' .. tostring(getCheatEngineDir()))
  local mods = enumModules()
  local found = 0
  for k, m in pairs(mods) do
    if tostring(m.Name):find('MonoDataCollector') then
      found = found + 1
      say(string.format('mono module: %s @ %X', tostring(m.Name), m.Address))
    end
  end
  if found == 0 then say('mono module: not loaded yet') end
end

local function ensureMono()
  if mono_AttachedProcess and mono_AttachedProcess ~= 0 then return true end
  if not mono_findClass then
    pcall(function() dofile(getCheatEngineDir() .. 'autorun\\monoscript.lua') end)
    pcall(function() reinitializeSymbolhandler(true) end)
  end
  if needRescan then
    needRescan = false
    if rescans > 3 then
      -- 已达重扫上限
    else
      rescans = rescans + 1
      pcall(function() reinitializeSymbolhandler(true) end)
    end
  end
  if LaunchMonoDataCollector then
    pcall(LaunchMonoDataCollector)
    needRescan = true
  end
  return false
end

-- ---------------------------------------------------------------- 解析
local function staticBase(clsName)
  local dms = mono_enumDomains()
  local domain = dms and dms[1]
  if not domain then return nil, 'no mono domain' end
  local cls = mono_findClass('', clsName)
  if not cls or cls == 0 then return nil, 'class not found: ' .. clsName end
  local base = nil
  pcall(function() base = mono_class_getStaticFieldAddress(domain, cls) end)
  if not base or base == 0 then return nil, 'no static area for ' .. clsName end
  return base
end

-- 按字段名取偏移（wantStatic: true=静态字段, false=实例字段）
local function fieldOffset(clsName, fieldName, wantStatic)
  local cls = mono_findClass('', clsName)
  if not cls or cls == 0 then return nil, 'class not found: ' .. clsName end
  local fds = mono_class_enumFields(cls)
  if not fds then return nil, 'field enum failed: ' .. clsName end
  local i
  for i = 1, #fds do
    local f = fds[i]
    if f.name == fieldName then
      if wantStatic and not f.isStatic then return nil, fieldName .. ' not static' end
      if (not wantStatic) and f.isStatic then return nil, fieldName .. ' is static' end
      return f.offset
    end
  end
  return nil, 'field not found: ' .. clsName .. '.' .. fieldName
end

-- GUIHUDManager.instance（静态单例）
local function hudManager()
  local base, err = staticBase('GUIHUDManager')
  if not base then return nil, err end
  local off, err2 = fieldOffset('GUIHUDManager', 'instance', true)
  if not off then return nil, err2 end
  local v = readPointer(base + off)
  if not v or v == 0 then return nil, 'GUIHUDManager.instance is null (未进场景?)' end
  return v
end

local function healthObject()
  local hud, err = hudManager()
  if not hud then return nil, err end
  local o1, e1 = fieldOffset('GUIHUDManager', 'healthGUI', false)
  if not o1 then return nil, e1 end
  local hc = readPointer(hud + o1)
  if not hc or hc == 0 then return nil, 'healthGUI is null' end
  local o2, e2 = fieldOffset('HealthCanvasManager', 'health', false)
  if not o2 then return nil, e2 end
  local h = readPointer(hc + o2)
  if not h or h == 0 then return nil, 'Health is null' end
  return h
end

local function gaugeObject()
  local hud, err = hudManager()
  if not hud then return nil, err end
  local o, e = fieldOffset('GUIHUDManager', 'arouseGaugeManager', false)
  if not o then return nil, e end
  local g = readPointer(hud + o)
  if not g or g == 0 then return nil, 'arouseGaugeManager is null' end
  return g
end

local function objFor(name)
  if name == 'HEALTH' then return healthObject() end
  if name == 'GAUGE'  then return gaugeObject()  end
  return nil, 'unknown obj: ' .. tostring(name)
end

local function resolve(key)
  -- 注意：查 ALL_ITEMS（含隐藏项与状态开关），
  -- 因为面板要读 快感上限 等不显示在界面上的值
  local i
  for i = 1, #ALL_ITEMS do
    local it = ALL_ITEMS[i]
    if it.key == key then
      local obj, err = objFor(it.obj)
      if not obj then return nil, err end
      local cls = (it.obj == 'HEALTH') and HEALTH_CLASS or GAUGE_CLASS
      local off, e2 = fieldOffset(cls, it.field, false)
      if not off then return nil, e2 end
      return obj + off
    end
  end
  return nil, 'unknown key: ' .. tostring(key)
end

-- 按 key 取条目定义（供 getVal/setVal 等判断类型与选项）
local function findItem(key)
  local i
  for i = 1, #ALL_ITEMS do
    if ALL_ITEMS[i].key == key then return ALL_ITEMS[i] end
  end
  return nil
end

local function rd(it, a)
  if it.vt == 'float' then return readFloat(a) end
  return readInteger(a)
end

local function wr(it, a, v)
  if it.vt == 'float' then writeFloat(a, v) else writeInteger(a, v) end
end

local function apply()
  local al = getAddressList()
  local n, firstErr = 0, nil
  local i
  -- ① 解析【全部】条目地址（含隐藏项与状态开关 —— 面板要用，但不进 CE 列表）
  for i = 1, #ALL_ITEMS do
    local it = ALL_ITEMS[i]
    local a, err = resolve(it.key)
    if a then
      ADDR[it.key] = a
    else
      if firstErr == nil then firstErr = err end
    end
  end
  -- ② 只把 WANT（用户可见的数值行）写进 CE 地址列表
  for i = 1, #WANT do
    local it = WANT[i]
    local a = ADDR[it.key]
    if a then
      n = n + 1
      local mr = nil
      local j
      for j = 0, al.Count - 1 do
        local m = al.getMemoryRecord(j)
        if m.Description == it.key then mr = m break end
      end
      if mr == nil then mr = al.createMemoryRecord() end
      mr.Description = it.key
      if it.vt == 'float' then mr.Type = vtSingle else mr.Type = vtDword end
      mr.Address = string.format('%X', a)
    end
  end

  -- 解析 Player（三个异常状态家族要从 Player -> StatusEffectManager 走）
  -- 链路：Health --(搜指向它的指针)--> PlayerHealthManager --(+0xD8)--> Player
  PLAYER_ADDR = nil
  local hObj = nil
  pcall(function() hObj = healthObject() end)
  if hObj and hObj ~= 0 then
    local h1 = findPtrTo(hObj)
    if h1 then
      for k = 0, h1.Count - 1 do
        local mgr = getAddress(h1[k]) - 0x20
        if clsNameOf(mgr) == 'PlayerHealthManager' then
          local h2 = findPtrTo(mgr)
          if h2 then
            for m2 = 0, h2.Count - 1 do
              local p = getAddress(h2[m2]) - 0xD8
              if clsNameOf(p) == 'Player' then PLAYER_ADDR = p break end
            end
          end
          break
        end
      end
    end
  end
  if PLAYER_ADDR then
    say(string.format('Player = %X', PLAYER_ADDR))
  else
    say('Player 未解析 —— 异常状态家族功能不可用')
  end

  say(string.format('resolved %d visible + %d hidden/switch', n, #WANT_HIDDEN + #SWITCHES))
  if n == 0 then return 0, firstErr end
  return n
end

-- ---------------------------------------------------------------- 退出
local function quitTrainer()
  pcall(closeCE)
end

pcall(function()
  if MainForm ~= nil then
    local prev = MainForm.OnClose
    MainForm.OnClose = function(sender)
      if prev then pcall(prev, sender) end
    end
  end
end)

-- ---------------------------------------------------------------- 锁定
local LOCKS = {}
local LOCKVAL = {}
local AROUSE_FAILS = 0        -- 连续失败计数（用于日志节流）
local AROUSE_TICKS = 0        -- 锁定心跳计数（确认定时器真的在跑）

local function tickLocks()
  local i
  for i = 1, #WANT do
    local k = WANT[i].key
    -- ⚠️ 性快感要排除在通用循环之外！
    --   通用循环用 wr() 直接写内存，而 Arouse 的 ADDR 是【UI 副本】地址，
    --   写它无效（游戏不认，且会被下次推送覆盖）。
    --   性快感必须走 setArouse()（正规 Set 方法）—— 见下面的专门分支。
    --   踩过的坑：用行内 □ 按钮锁 Arouse 时只设了 LOCKS['Arouse']，
    --   于是进了这个通用循环、写的却是无效字段 —— 界面上显示红了但没人管，
    --   而 setArouse 分支因为 AROUSE_LOCK 是 false 从不进入，心跳日志一片空白。
    if k ~= 'Arouse' and LOCKS[k] and ADDR[k] and LOCKVAL[k] then
      local it = WANT[i]
      local cur = rd(it, ADDR[k])
      if cur ~= LOCKVAL[k] then wr(it, ADDR[k], LOCKVAL[k]) end
    end
  end
  -- 性快感：走 setArouse（正规 Set 方法，UI 会同步）
  -- 注意：真源一旦设定，游戏仍会按 decreasePerSecond 自然递减，
  --       所以要"锁定"就得周期重设 —— 但重设也要走正规方法。
  --
  -- 锁定开关只有一个：LOCKS['Arouse']（由该行的 □ 按钮设置）。
  -- 不再有 AROUSE_LOCK 这样的平行开关 —— 多入口就是 bug 温床（见下方设计说明）。
  if LOCKS.Arouse and LOCKVAL.Arouse then
    local arouseWant = LOCKVAL.Arouse
    AROUSE_TICKS = (AROUSE_TICKS or 0) + 1
    if AROUSE_TICKS == 1 or (AROUSE_TICKS % 40) == 0 then
      -- 心跳：每 40 次（约 20 秒）记一条，确认定时器在跑、以及当前真值
      local hv = nil
      pcall(function() hv = getArouseHeat() end)
      say(string.format('[arouse-lock] tick#%d 目标=%.2f 真值=%s', AROUSE_TICKS,
        arouseWant, hv and string.format('%.2f', hv) or '?'))
    end
    local ok, msg = setArouse(arouseWant)
    if not ok then
      AROUSE_FAILS = AROUSE_FAILS + 1
      if AROUSE_FAILS == 1 or (AROUSE_FAILS % 10) == 0 then
        say(string.format('[arouse-lock] 重设失败 x%d: %s', AROUSE_FAILS, tostring(msg)))
      end
    else
      if AROUSE_FAILS > 0 then
        say(string.format('[arouse-lock] 恢复成功（此前失败 %d 次）', AROUSE_FAILS))
        AROUSE_FAILS = 0
      end
    end
  end
end

-- ---------------------------------------------------------------- 面板
--[[
  设置"开关"控件的显示状态。

  ⚠️ 踩坑（用户报"开关类选项无法勾选中"）：
    CE 的 Lua 里没有可用的 createCheckBox，所以开关是用
    createButton + '□'/'■' 符号【模拟】的。
    一开始我在 refresh() 里写 `r.Checked = on` —— 但【按钮没有 Checked 属性】，
    pcall 把失败吞掉，符号永远停在初始的 '□'，看起来就是"点了没反应"。
    （实际内存值已经改了，日志里 [switch] XXX -> 1 能证明，只是界面没反馈。）

  正解：显式改 Caption（符号）+ 颜色。
]]
local function setToggleState(btn, on)
  if not btn then return end
  pcall(function() btn.Caption = on and '■' or '□' end)
  pcall(function() btn.Font.Color = on and 0x0040C0FF or 0x00FFFFFF end)
end

local function refresh()
  local i
  for i = 1, #WANT do
    local it = WANT[i]
    local k = it.key
    local a = ADDR[k]
    local r = ROWS[k]
    if r and a then
      -- ⚠️ 显示策略（踩过坑后改的）：
      --   以前是"锁定中就显示锁定值"，结果锁定【实际失效】时界面照样显示目标值，
      --   玩家看到 23.00 而真实值是 40.23 —— 把失败给遮盖了。
      --   现在一律读【真值】：锁定生效时真值≈目标（正常色）；
      --   不生效时真值≠目标（标红），问题立刻可见。
      local v
      if k == 'Arouse' then
        -- 性快感读真源（SexualHeatManager._heat），不是 UI 副本
        local hv = nil
        pcall(function() hv = getArouseHeat() end)
        v = hv or rd(it, a)
      else
        v = rd(it, a)
      end
      if v == nil then v = -1 end

      -- 锁定口径：只用 LOCKS / LOCKVAL（每个数值条目一套，唯一来源）
      local locked, target = LOCKS[k], LOCKVAL[k]

      local mismatch = false
      if locked and target then
        -- float 用容差比较，int 精确比较
        if it.vt == 'float' then
          local d = v - target
          if d > 0.05 or (-d) > 0.05 then mismatch = true end
        else
          if v ~= target then mismatch = true end
        end
      end

      if it.vt == 'float' then
        r.cur.Caption = string.format('%.2f', v)
      else
        r.cur.Caption = tostring(v)
      end
      -- 锁定开关的【符号】要跟着锁定态更新
      -- （原先只改了"当前值"文字的颜色，没动开关符号 —— 用户会以为没点上）
      setToggleState(r.lock, locked)

      if r.lock then
        if not locked then
          r.cur.Font.Color = 0x00FFFFFF
        elseif mismatch then
          r.cur.Font.Color = 0x000000FF   -- 锁定中但没锁住 -> 标红（蓝通道为 0 的纯红）
        else
          r.cur.Font.Color = 0x0020A0FF   -- 锁定生效 -> 橙黄
        end
      end
    end
  end
  -- 注意：用户拍板【移除汇总监控行】。
  -- 每行的「当前」列本身就是监控（读真值），符合 CE 原本的 UI 意图，
  -- 汇总行属于重复展示，去掉以降低维护面。

  -- 状态开关（勾选框）：勾选态 = 该状态生效
  local si
  for si = 1, #SWITCHES do
    local sw = SWITCHES[si]
    local r = ROWS['sw_' .. sw.key]
    local a = ADDR[sw.key]
    if r and a then
      local it = findItem(sw.key)
      local v = it and rd(it, a) or readInteger(a)
      local on = (v ~= nil and v ~= 0)
      setToggleState(r, on)
    end
  end

  -- 三个异常状态家族的当前等级
  if PLAYER_ADDR then
    local lv = nil
    pcall(function() lv = familyLevels() end)
    if lv then
      for i = 1, #FAMILIES do
        local fam = FAMILIES[i]
        if fam.row then
          local v = lv[fam.id] or 0
          if v > 0 then
            -- 与档位按钮风格统一：直接显示罗马数字
            fam.row.Caption = LV_ROMAN[v] or tostring(v)
            pcall(function() fam.row.Font.Color = 0x0040C0FF end)
          else
            fam.row.Caption = '0'
            pcall(function() fam.row.Font.Color = 0x00808080 end)
          end
        end
      end
    end
  end
end

local function setVal(k, v)
  -- 性快感特例：必须走 SexualHeatManager.Set()，直接写字段 UI 不动
  -- （详见 setArouse 上方的说明）
  if k == 'Arouse' then
    local ok, msg = setArouse(v)
    if not ok then say('[arouse] 设置失败: ' .. tostring(msg)) end
    return
  end
  local a = ADDR[k]
  if a == nil then return end
  local it = findItem(k)
  if it then wr(it, a, v) end
end

local function getVal(k)
  local a = ADDR[k]
  if a == nil then return 0 end
  local it = findItem(k)
  if it then return rd(it, a) end
  return 0
end

--[[
  锁定开关（正方形控件，不是按钮）

  用户拍板：锁定显示为【状态开关样式的正方形控件】，既表达二态、又省宽度。

  契约（唯一入口原则）：
    - 锁定值 = 点击锁定那一刻的【当前值】；若输入框里有数字，则以输入框为准
    - 锁定后由 tickLocks 周期重设；再次点击解除
]]
local function toggleLock(k)
  local r = ROWS[k]
  if r == nil or ADDR[k] == nil then return end
  if LOCKS[k] then
    LOCKS[k] = false
    LOCKVAL[k] = nil
    say('unlock ' .. k)
  else
    local v = tonumber(r.edit.Text)
    if v == nil then v = getVal(k) end
    local it = findItem(k)
    if it and it.vt ~= 'float' then v = math.floor(v) end
    LOCKS[k] = true
    LOCKVAL[k] = v
    setVal(k, v)
    if r.edit then r.edit.Text = '' end
    say(string.format('lock %s = %s', k, tostring(v)))
  end
  refresh()
end

-- 加减（直接改值，不需要"应用"）
-- 若该值处于锁定态，则同时把锁定目标一起挪动，保持"锁定中调值"的直觉行为
local function bump(k, d)
  local a = ADDR[k]
  if a == nil then return end
  local base = LOCKS[k] and LOCKVAL[k] or getVal(k)
  local v = base + d
  -- 写成 > 形式，避免裸尖括号（.CT 是 XML）
  if v > 0 then else v = 0 end
  setVal(k, v)
  if LOCKS[k] then LOCKVAL[k] = v end
  refresh()
end

-- 归零（用户拍板：仅"当前值"性质的项开放；上限/开关性质的项目不显示此按钮）
local function zeroVal(k)
  if ADDR[k] == nil then return end
  setVal(k, 0)
  if LOCKS[k] then LOCKVAL[k] = 0 end
  refresh()
end

-- 拉到运行时上限（MAX）
-- 用户拍板语义：把「当前值」改为「运行时上限值」——
--   上限从 maxKey 指向的条目实时读取，不做额外裁剪。
--   本游戏：HP→HP上限、体力→体力上限、性快感→快感上限(100)
local function maxVal(k)
  local it = findItem(k)
  if not it or not it.maxKey then return end
  local mv = getVal(it.maxKey)
  if mv == nil then return end
  setVal(k, mv)
  if LOCKS[k] then LOCKVAL[k] = mv end
  refresh()
end

-- 应用输入框里的值（"应用"按钮）
local function writeField(k)
  local r = ROWS[k]
  if r == nil then return end
  local v = tonumber(r.edit.Text)
  if v == nil then
    if r.cur then r.cur.Caption = '无效' end
    return
  end
  local it = findItem(k)
  if it and it.vt ~= 'float' then v = math.floor(v) end
  setVal(k, v)
  if LOCKS[k] then LOCKVAL[k] = v end
  r.edit.Text = ''
  refresh()
end

-- 状态开关（勾选框）：勾选 = 置 1，取消 = 置 0
local function toggleSwitch(key)
  local a = ADDR[key]
  if a == nil then return end
  local it = findItem(key)
  local cur = it and rd(it, a) or readInteger(a)
  local on = (cur ~= nil and cur ~= 0)
  local nv = on and 0 or 1
  if it then wr(it, a, nv) else writeInteger(a, nv) end
  say(string.format('[switch] %s -> %d', key, nv))
  refresh()
end

local function setFont(c)
  pcall(function() c.Font.Size = FS end)
end

local function mkLabel(owner, x, y, w, h, cap)
  local l = createLabel(owner)
  l.Left = x; l.Top = y; l.Width = w; l.Height = h; l.Caption = cap
  setFont(l)
  return l
end

local function mkEdit(owner, x, y, w, h)
  local e = createEdit(owner)
  e.Left = x; e.Top = y; e.Width = w; e.Height = h; e.Text = ''
  setFont(e)
  return e
end

local function mkButton(owner, x, y, w, h, cap, fn)
  local b = createButton(owner)
  b.Left = x; b.Top = y; b.Width = w; b.Height = h; b.Caption = cap
  b.OnClick = function(sender) pcall(fn) end
  setFont(b)
  return b
end

-- 正方形按钮（用于 [-] [+] [0] [MAX] 这类单字符/短标签操作按钮）
--   用户拍板：加减按钮宽=高。整个"操作按钮"列宽统一按正方形边长走，排版工整。
local function mkSquareButton(owner, x, y, side, cap, fn)
  return mkButton(owner, x, y, side, side, cap, fn)
end

-- 正方形状态开关（用于"锁定"）
--   用户拍板：锁定不做成按钮样式，改用状态开关式的正方形控件。
--
--   ⚠️ 实现说明：CE 的 createButton 没有 Checked 属性（那是 CheckBox 的），
--   而 CE 的 Lua 里没有直接暴露 createCheckBox。
--   所以这里用【按钮 + 自绘文字符号】模拟开关外观：
--     未锁 = "□"（空心方框，白色）
--     已锁 = "■"（实心方块，橙黄）
--   行为上仍是"点击切换"，与勾选框等价，且宽度 = 高度（正方形）。
local function mkLockToggle(owner, x, y, side, fn)
  local b = createButton(owner)
  b.Left = x; b.Top = y; b.Width = side; b.Height = side
  b.Caption = '□'
  b.OnClick = function(sender) pcall(fn) end
  setFont(b)
  return b
end


-- 按字高保守估算文字宽度。
--   汉字实际宽度 ≈ 1 个字高（CE 默认字体下混排时略宽），故系数取 1.35
--   （原为 1.15，实测在用户会话会把「体力硬上限」这类 5 字标签算窄、导致截断）。
local function estW(s, th)
  local hi = 0
  local i
  for i = 1, #s do if s:byte(i) > 127 then hi = hi + 1 end end
  local wide = hi / 3
  local ascii = #s - hi
  return math.floor(ascii * th * 0.62 + wide * th * 1.35 + 0.5)
end

local function buildPanel()
  if panel ~= nil then return end
  pcall(hideAllCEWindows)

  local f = createForm(false)
  pcall(function() f.DoNotSaveInTable = true end)
  f.Caption = 'Nurtale Nesche 修改器'
  -- 任务栏显示（用户要求）：CE 的 createForm 默认 stDefault（不进任务栏）。
  -- ⚠️ 必须用数字：LCL 枚举常量（stAlways 等）在 CE 的 Lua 全局里不存在（是 nil），
  --    写 f.ShowInTaskbar = stAlways 会静默失败（回读仍是 stDefault）。
  pcall(function() f.ShowInTaskbar = 1 end)
  -- 窗口左上角图标（替换原 CE 的图标）
  --
  -- ⚠️ 关键：**必须用 PNG，不能用 ICO**！
  --   实测（2026-09-20）：CE 的 Picture.loadFromFile() 加载本项目的 .ico 时
  --   "返回 true 但实际是空的" —— Icon/Bitmap/PNG/Graphic 的 Width/Height 全是 0，
  --   赋给 f.Icon 后窗体图标不变（表现为"图标没换上"）。
  --   原因：该 ICO 是 Vista+ 的【内嵌 PNG】格式，CE 的解析器只认传统位图格式。
  --   改用 PNG 后 picture.Icon 立刻有内容（32x32），f.Icon 回读也是 32x32。
  --
  -- 图标来源：make_trainer.py 会把 NyaaTrainer_icon_32.png 打进归档，
  --   解压后位于 getCheatEngineDir() 下。
  pcall(function()
    local d = getCheatEngineDir()
    if d:sub(-1) ~= '\\' then d = d .. '\\' end
    local pngPath = d .. 'NyaaTrainer_icon_32.png'
    local pic = createPicture()
    pic.loadFromFile(pngPath)
    local w = 0
    pcall(function() w = pic.Icon.Width or 0 end)
    if w > 0 then
      f.Icon = pic.Icon
      say(string.format('window icon loaded: %dx%d (%s)', w, pic.Icon.Height, pngPath))
    else
      say('window icon FAILED (size 0): ' .. pngPath)
    end
  end)
  setFont(f)

  local TH = math.floor(FS * 1.4)
  pcall(function()
    local probe = createEdit(f)
    setFont(probe)
    local v = probe.Font.Height
    if type(v) == 'number' then TH = math.abs(v) end
    probe.destroy()
  end)

  local PAD  = 14
  local GAP  = 12
  local SIDE = TH + PAD * 2                    -- 正方形控件的边长（操作按钮 / 锁定开关）
  local BTN_H = SIDE
  local LBL_H = TH + 8
  local ROW_H = SIDE + 10

  -- 宽度：全部由内容决定，最后统一封顶
  local nameProbe = '属性'
  do
    local q
    for q = 1, #WANT do
      if #WANT[q].label > #nameProbe then nameProbe = WANT[q].label end
    end
    local q2
    for q2 = 1, #SWITCHES do
      if #SWITCHES[q2].label > #nameProbe then nameProbe = SWITCHES[q2].label end
    end
    local q3
    for q3 = 1, #FAMILIES do
      if #FAMILIES[q3].cn > #nameProbe then nameProbe = FAMILIES[q3].cn end
    end
  end

  local W_NAME = math.floor(estW(nameProbe, TH) * 1.35) + PAD * 2
  local W_NUM  = math.floor(estW('9999.99', TH) * 1.70) + PAD * 2
  -- 输入框：用户拍板"保留当前字体十个 9 这样的宽度就够"
  local W_EDIT = math.floor(estW('9999999999', TH) * 1.10) + PAD * 2
  local W_APPLY = math.floor(estW('应用', TH) * 1.40) + PAD * 2   -- 够 2 个字即可

  -- 数值行横向布局（用户拍板的顺序）：
  --   [属性] [当前] | [0] [-] [+] [MAX] | [输入框] [应用] | [锁定]
  --   说明：0/-/+ /MAX 是一组（直接改值，不需"应用"）；
  --         输入框 + 应用 是一组（输入需提交）。
  local X_NAME  = PAD
  local X_CUR   = X_NAME + W_NAME + GAP
  local X_ZERO  = X_CUR + W_NUM + GAP
  local X_MINUS = X_ZERO + SIDE + 4
  local X_PLUS  = X_MINUS + SIDE + 4
  -- MAX 按钮比正方形略宽（用户拍板：不超过高度的 1.5 倍，保证 "MAX" 三个字符完整）
  local W_MAXB  = math.floor(SIDE * 1.45)
  local X_MAX   = X_PLUS + SIDE + 4
  local X_EDIT  = X_MAX + W_MAXB + GAP
  local X_APPLY = X_EDIT + W_EDIT + 6
  local X_LOCK  = X_APPLY + W_APPLY + GAP
  local FW_ROW  = X_LOCK + SIDE + PAD

  -- 状态开关行：[名称] [开关] （+ 说明文字）
  local W_SWNOTE = math.floor(estW('开启后受到攻击不掉血', TH) * 1.10)
  local X_SWTOG = X_NAME + W_NAME + GAP
  local FW_SW   = X_SWTOG + SIDE + GAP + W_SWNOTE + PAD

  -- 定制选项行（异常状态）：[名称] [当前] [0] [Ⅰ] [Ⅱ] [Ⅲ]
  local X_LV    = X_NAME + W_NAME + GAP
  local X_S1    = X_LV + W_NUM + GAP
  local W_LVB   = math.floor(estW('Ⅲ', TH) * 2.2) + PAD * 2
  local FW_FAM  = X_S1 + 4 * (W_LVB + 6) + PAD

  -- 工具条（顶部）：刷新等"修改器本体功能"
  local W_TBBTN = math.floor(estW('刷新', TH) * 1.40) + PAD * 2
  local H_TBAR  = SIDE + PAD
  local FW_TBAR = PAD + W_TBBTN + PAD

  -- 底部按钮区（用户拍板：本版本清空）
  --
  -- 删掉的两项及理由：
  --   「重置锁定」—— 与每个数值行各自的锁定开关构成【多处维护】，
  --                  且"重置"的语义有风险（用户可能没意识到会解除哪些锁定）
  --   「全部拉满」—— 一次性把所有值推到上限，存在数值风险
  -- 结论：宁可少一个便利按钮，也不要一个"可能造成意外"的按钮。
  local quick = {}

  local qw, qsum = {}, 0
  local i
  for i = 1, #quick do
    qw[i] = math.floor(estW(quick[i].cap, TH) * 1.40) + PAD * 2
    qsum = qsum + qw[i]
  end
  qsum = qsum + GAP * (#quick - 1) + PAD * 2

  local FW = math.max(FW_ROW, FW_SW, FW_FAM, FW_TBAR, qsum)

  -- 高度：工具条 + 数值区(标题+行) + 状态开关区 + 定制选项区 + 底部按钮
  local HEAD_H = TH + PAD
  local FH = H_TBAR
             + HEAD_H + #WANT * ROW_H + PAD
             + HEAD_H + #SWITCHES * ROW_H + PAD
             + HEAD_H + #FAMILIES * ROW_H + PAD
             + BTN_H + PAD + 8

  -- ------------------------------------------------------------------
  -- 宽度上限（用户拍板：1536）
  --
  -- 实测依据：CE 窗体实际渲染宽度受屏幕限制
  --   （getScreenWidth()=1024 时面板最多 1038，而布局按 1758 算 -> 右侧全看不见）。
  -- 用户会话下 1536 能完整容纳所有控件，故固定取此值。
  -- 压缩时：所有参与横向排布的宽度都要乘系数（漏一个就溢出），
  --         且名字列设保底（绝不窄于最长标签所需）。
  -- ------------------------------------------------------------------
  local MAXW = 1536
  if FW > MAXW then
    local k = MAXW / FW
    local minName = math.floor(estW(nameProbe, TH) * 1.25) + PAD * 2
    local function sq(v, mn) return math.max(mn or 24, math.floor(v * k)) end
    W_NAME  = math.max(minName, sq(W_NAME, 60))
    W_NUM   = sq(W_NUM, 50)
    W_EDIT  = sq(W_EDIT, 60)
    W_APPLY = sq(W_APPLY, 40)
    W_MAXB  = math.max(math.floor(SIDE * 1.25), sq(W_MAXB, 40))
    W_LVB   = sq(W_LVB, 26)
    W_TBBTN = sq(W_TBBTN, 46)
    GAP     = sq(GAP, 6)
    X_NAME  = PAD
    X_CUR   = X_NAME + W_NAME + GAP
    X_ZERO  = X_CUR + W_NUM + GAP
    X_MINUS = X_ZERO + SIDE + 4
    X_PLUS  = X_MINUS + SIDE + 4
    X_MAX   = X_PLUS + SIDE + 4
    X_EDIT  = X_MAX + W_MAXB + GAP
    X_APPLY = X_EDIT + W_EDIT + 6
    X_LOCK  = X_APPLY + W_APPLY + GAP
    local fwRows = X_LOCK + SIDE + PAD
    local fwSw   = X_SWTOG + SIDE + GAP + sq(W_SWNOTE, 80) + PAD
    local fwFam  = X_S1 + 4 * (W_LVB + 6) + PAD
    FW = math.max(fwRows, fwSw, fwFam, PAD + W_TBBTN + PAD)
    say(string.format('width capped by k=%.2f -> %d (rows %d sw %d fam %d)', k, FW, fwRows, fwSw, fwFam))
  else
    say(string.format('width not capped: FW=%d (MAXW %d)', FW, MAXW))
  end

  say(string.format('metrics: textH=%d side=%d -> form %dx%d', TH, SIDE, FW, FH))

  f.Width = FW
  f.Height = FH

  local y = 0

  -- ================================================================
  -- 模块 1：工具条（修改器本体功能）
  --   用户拍板：刷新这类"只属于工具本身"的功能放工具条，
  --   与游戏修改功能分开排版，避免理解混淆。
  --   预留位置：将来的"重新连接进程 / 检查连接 / 版本号 / 下载地址"放同一区。
  --   注意：本版本不开发那些功能，只放「刷新」。
  -- ================================================================
  mkButton(f, PAD, math.floor(PAD / 2), W_TBBTN, SIDE, '刷新', refresh)
  y = H_TBAR

  -- ================================================================
  -- 模块 2：数值修改
  --   每行：[属性名] [当前值] [0] [-] [+] [MAX] [输入框] [应用] [锁定开关]
  --   0 / - / + / MAX 是一组（直接改值）；输入框 + 应用 是一组（需提交）。
  --   上限性质的项不显示 0（禁归零）；无上限概念的项不显示 MAX（但保留占位）。
  -- ================================================================
  -- 模块标题：用【更大字号 + 醒目颜色 + 底部横线】与内容区分
  --
  -- ⚠️ 踩坑：LCL 的 Font.Style 是【集合类型】，在 CE 的 Lua 里设不了 ——
  --   写 l.Font.Style = 1 / fsBold / {fsBold} 全都"不报错但回读恒为 []"
  --   （且 fsBold 这个全局常量在 CE 里根本不存在，是 nil）。
  --   正解：改用【字号】区分（Font.Size 可写，实测有效），再用颜色强化。
  -- 标题字号：只比正文大 2pt。之前用 FS+4（16pt）在 12pt 正文旁显得过大，
  -- 且【布局仍按 12pt 的 TH 算】，标题实际字高更大 -> 与下一行重叠。
  -- 现在 TITLE_FS 与 SEC_H 都基于【实际字高】推算。
  local TITLE_FS = FS + 2
  local TITLE_TH = math.floor(TITLE_FS * (TH / FS))     -- 按正文的字高/字号比例推算标题字高
  local function sectionTitle(txt, yy)
    local l = mkLabel(f, PAD, yy, FW - PAD * 2, TITLE_TH + 6, txt)
    pcall(function() l.Font.Size = TITLE_FS end)
    pcall(function() l.Font.Color = 0x0060D0FF end)   -- 亮橙，与正文白色区分
    -- 标题下的分隔线（用一条细 Label 模拟横线）
    local line = createLabel(f)
    line.Left = PAD
    line.Top = yy + TITLE_TH + 4
    line.Width = FW - PAD * 2
    line.Height = 2
    pcall(function() line.Caption = '' end)
    pcall(function() line.Color = 0x00505050 end)
    return l
  end

  -- 模块标题区占用的高度
  -- 模块标题区高度 = 标题实际字高 + 分隔线 + 上下留白
  --   之前误用 TITLE_FS（字号数值）当高度，而字高≈字号×2.7，
  --   导致标题溢出到下一行、与列标题重叠。
  local SEC_H = TITLE_TH + 22

  sectionTitle('数值修改', y)
  y = y + SEC_H
  -- 列标题行：与第一行数据之间留足垂直间隔（原先会与内容重叠）
  mkLabel(f, X_NAME, y, W_NAME, TH + 6, '属性')
  mkLabel(f, X_CUR,  y, W_NUM,  TH + 6, '当前')
  mkLabel(f, X_EDIT, y, W_EDIT + 6 + W_APPLY, TH + 6, '设定值')
  mkLabel(f, X_LOCK, y, SIDE, TH + 6, '锁定')
  y = y + TH + math.floor(PAD * 1.6)

  for i = 1, #WANT do
    local it = WANT[i]
    local k = it.key
    mkLabel(f, X_NAME, y + math.floor(PAD / 2), W_NAME, LBL_H, it.label)
    local cur = mkLabel(f, X_CUR, y + math.floor(PAD / 2), W_NUM, LBL_H, '?')

    -- 0 按钮：仅"当前值"性质开放（用户拍板：上限性质隐藏，避免 HP上限=0 让游戏出错）
    if not it.noZero then
      mkSquareButton(f, X_ZERO, y, SIDE, '0', function() zeroVal(k) end)
    else
      -- 隐藏但保留占位：不创建控件即可，坐标天然留空
    end
    mkSquareButton(f, X_MINUS, y, SIDE, '-', function() bump(k, -1) end)
    mkSquareButton(f, X_PLUS,  y, SIDE, '+', function() bump(k, 1) end)
    -- MAX 按钮：仅定义了 maxKey 的项
    if it.maxKey then
      -- 用户要求：MAX 文本【缩小字号】，让视觉不拥挤。
      -- 按钮尺寸保持原样（W_MAXB，约 1.45 倍正方形宽），**不动**。
      local mb = mkButton(f, X_MAX, y, W_MAXB, SIDE, 'MAX', function() maxVal(k) end)
      pcall(function() mb.Font.Size = FS - 3 end)
    end

    local ed = mkEdit(f, X_EDIT, y + math.floor((SIDE - (LBL_H + 6)) / 2), W_EDIT, LBL_H + 6)
    mkButton(f, X_APPLY, y, W_APPLY, SIDE, '应用', function() writeField(k) end)
    local lk = mkLockToggle(f, X_LOCK, y, SIDE, function() toggleLock(k) end)

    ROWS[k] = { cur = cur, edit = ed, lock = lk }
    y = y + ROW_H
  end
  y = y + PAD

  -- ================================================================
  -- 模块 3：状态开关（无数值，只有 生效/不生效）
  --   用户拍板：这类项目从"数值修改"里拿出来，单独一组，
  --   控件用【开关】而不是"开/关"两个按钮（两个按钮既是重复入口又占宽度）。
  -- ================================================================
  sectionTitle('状态开关', y)
  y = y + SEC_H
  for i = 1, #SWITCHES do
    local sw = SWITCHES[i]
    mkLabel(f, X_NAME, y + math.floor(PAD / 2), W_NAME, LBL_H, sw.label)
    local tog = mkLockToggle(f, X_SWTOG, y, SIDE, function() toggleSwitch(sw.key) end)
    mkLabel(f, X_SWTOG + SIDE + GAP, y + math.floor(PAD / 2), W_SWNOTE, LBL_H, sw.tip or '')
    ROWS['sw_' .. sw.key] = tog
    y = y + ROW_H
  end
  y = y + PAD

  -- ================================================================
  -- 模块 4：定值选项（带固定数值的互斥状态）
  --
  -- ★ 命名规范（用户 2026-09-20 明确，指导后续所有项目）：
  --   叫「定值选项」，**不是**「定制选项」。
  --   含义：取值被游戏硬约束在一个有限集合内、彼此互斥、**不允许用户填入任意数值**
  --         的选项 —— 例如异常状态等级只能是 0/Ⅰ/Ⅱ/Ⅲ。
  --   控件形式：**每个取值一个按钮**（不用输入框），点哪个就是哪个。
  --
  --   与「数值修改」的区别：
  --     数值修改 = 用户可填任意值（有输入框）
  --     定值选项 = 取值由游戏限定，只能从给定档位里挑
  -- ================================================================
  sectionTitle('定值选项', y)
  y = y + SEC_H
  for i = 1, #FAMILIES do
    local fam = FAMILIES[i]
    local yRow = y
    mkLabel(f, PAD, yRow + math.floor(PAD / 2), W_NAME, LBL_H, fam.cn)
    local lvLbl = mkLabel(f, X_LV, yRow + math.floor(PAD / 2), W_NUM, LBL_H, '-')
    fam.row = lvLbl
    for lv = 0, 3 do
      local xb = X_S1 + lv * (W_LVB + 6)
      local cap = LV_ROMAN[lv]
      local target = lv
      mkButton(f, xb, yRow, W_LVB, SIDE, cap, function()
        if target == 0 then
          local n = familyClear(fam.id, 3)
          say(string.format('[status] %s 清除（降 %d 级）', fam.cn, n))
        else
          local ok, msg = familyOp(fam.id, 'set', target)
          say(string.format('[status] %s = %s : ok=%s %s', fam.cn, LV_ROMAN[target], tostring(ok), tostring(msg)))
        end
        refresh()
      end)
    end
    y = y + ROW_H
  end
  y = y + PAD

  -- ================================================================
  -- 模块 5：底部一次性动作
  --   用户拍板：这里【只放一次性动作】，不放任何锁定类按钮
  --   （锁定唯一入口 = 各数值行的锁定开关）。
  -- ================================================================
  local qx, qy = PAD, y
  for i = 1, #quick do
    if qx + qw[i] > FW - PAD then
      qx = PAD
      qy = qy + BTN_H + 8
    end
    mkButton(f, qx, qy, qw[i], BTN_H, quick[i].cap, quick[i].fn)
    qx = qx + qw[i] + GAP
  end
  local extra = (qy - y)
  if extra > 0 then
    f.Height = f.Height + extra
  end

  -- 面板关闭 = 退出修改器（与右上角 X 同一路径 —— 用户拍板去掉「关闭」按钮，
  -- 因为两者功能完全一致，保留两处只会增加维护成本）
  f.OnClose = function(sender) quitTrainer() end
  pcall(function() f.centerScreen() end)
  say(string.format('panel built: %dx%d', f.Width, f.Height))

  panel = f
  f.show()
  pcall(function() f.bringToFront() end)

  local lt = createTimer(MainForm, false)
  lt.Interval = 500
  lt.OnTimer = function(sender) pcall(tickLocks) end
  lt.Enabled = true
  _G.nn_lock_timer = lt

  local rt = createTimer(MainForm, false)
  rt.Interval = 500
  rt.OnTimer = function(sender) pcall(refresh) end
  rt.Enabled = true
  _G.nn_refresh_timer = rt

  refresh()
  say('panel created')
end

-- ---------------------------------------------------------------- 主循环
local function tick(sender)
  tries = tries + 1
  local ok, err = pcall(function()
    if not diagDone then diag() end
    if (getOpenedProcessID() or 0) == 0 then
      local pid = getProcessIDFromProcessName(PROCESS_NAME)
      if pid and pid ~= 0 then openProcess(pid) end
    end
    if ensureMono() then
      local n, why = apply()
      if n > 0 then
        sender.Enabled = false
        buildPanel()
      elseif tries % 20 == 0 then
        say('waiting: ' .. tostring(why))
      end
    end
  end)
  if not ok then say('error: ' .. tostring(err)) end
  if tries > 239 then
    sender.Enabled = false
    say('gave up after ' .. tries .. ' tries')
  end
end

local boot = createTimer(MainForm, false)
boot.Interval = 500
boot.OnTimer = tick
boot.Enabled = true
say('waiting for the mono collector...')
  </LuaScript>
</CheatTable>
